{
  "name": "wandofmagic",
  "version": "0.1.0-alpha.0",
  "description": "Typed, explainable data repair for TypeScript.",
  "author": "zsumz <shawn@zsumz.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsumz/wandofmagic.git"
  },
  "homepage": "https://github.com/zsumz/wandofmagic#readme",
  "bugs": {
    "url": "https://github.com/zsumz/wandofmagic/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./coerce": {
      "import": {
        "types": "./dist/coerce.d.ts",
        "default": "./dist/coerce.js"
      },
      "require": {
        "types": "./dist/coerce.d.cts",
        "default": "./dist/coerce.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.js"
      },
      "require": {
        "types": "./dist/compiler.d.cts",
        "default": "./dist/compiler.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "coerce": [
        "dist/coerce.d.ts"
      ],
      "compiler": [
        "dist/compiler.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "magicwand-logo.svg",
    "README.md"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "typescript",
    "data-transformation",
    "data-cleaning",
    "data-mapping",
    "validation",
    "normalization",
    "etl"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node scripts/maintenance/clean.mts",
    "build": "tsdown",
    "benchmark:deep": "npm run build && node scripts/benchmarks/deep/benchmark-deep.mts",
    "benchmark:flat": "npm run build && node scripts/benchmarks/flat/benchmark-flat.mts",
    "benchmark:types": "node scripts/benchmarks/types/benchmark-types.mts",
    "lint": "npm run build && eslint .",
    "lint:fix": "npm run build && eslint . --fix",
    "format": "npm run lint:fix",
    "architecture:check": "node scripts/architecture/check.mts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:scripts": "npm run build && tsc -p tsconfig.scripts.json",
    "typecheck:types": "npm run build && tsc -p tsconfig.types.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "coverage": "npm run build && vitest run --coverage",
    "smoke:list": "smoque list smoke/",
    "smoke": "smoque run smoke/ --ci",
    "check:code": "npm run build && eslint . && npm run architecture:check && tsc -p tsconfig.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.types.json && npm run benchmark:types && vitest run --coverage",
    "check:package": "smoque list smoke/ && smoque run smoke/ --ci && node scripts/release/dry-run-pack.mts",
    "check": "npm run check:code && npm run check:package",
    "validate": "npm run check",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/release/check-publish.mts",
    "publish:alpha": "npm publish --tag alpha --access public"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.6.0",
    "eslint-config-rubric": "^0.1.0-alpha.0",
    "fast-check": "4.9.0",
    "smoque": "^0.1.0-alpha.1",
    "tsdown": "^0.12.9",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
